{
  "name": "@cubert/body",
  "version": "1.0.0",
  "description": "Cubert Body Service - Mineflayer bot with sensors and actuators",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "proto:gen": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js --outDir=src/grpc/generated ../proto/cubert.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "mineflayer": "^4.20.0",
    "mineflayer-pathfinder": "^2.4.5",
    "minecraft-data": "^3.61.0",
    "uuid": "^9.0.0",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "nodemon": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
